# WatchTower API Configuration
# In production on Render:
VITE_API_BASE_URL=https://watchtower-website-change-detector-v2.onrender.com
API_BASE_URL=https://watchtower-website-change-detector-v2.onrender.com

# Google Gemini API (Configured on Render Backend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Storage (for persistent cloud screenshot storage)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=watchtower-screenshots

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=your_resend_api_key
